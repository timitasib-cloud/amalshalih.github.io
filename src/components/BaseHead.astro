---
import '../styles/global.css'
import { CONTACT, SITE, SOCIAL } from '@data/site'
import { getSiteSettings } from '@lib/sanity/client'
import { OpenPanelComponent } from '@openpanel/astro'

interface Props {
	title: string
	description: string
	image?: string
	pageType?: 'website' | 'article'
	/** ISO 8601 date string for article:published_time */
	publishedTime?: string
	/** ISO 8601 date string for article:modified_time */
	modifiedTime?: string
}

const {
	title,
	description,
	image = '/images/og-fallback.png',
	pageType = 'website',
	publishedTime,
	modifiedTime,
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// Fetch breadcrumb labels from Sanity (fallback to hardcoded defaults)
let breadcrumbLabels: Record<string, string> = {}
try {
	const settings = await getSiteSettings()
	if (settings?.breadcrumbLabels) {
		breadcrumbLabels = settings.breadcrumbLabels
	}
} catch (error) {
	console.error('[BaseHead] Site settings fetch failed:', error)
}

const defaultLabels: Record<string, string> = {
	beranda: 'Beranda',
	tentang: 'Tentang Kami',
	program: 'Program',
	kegiatan: 'Kegiatan',
	donasi: 'Donasi',
	kontak: 'Kontak',
	galeri: 'Galeri',
	blog: 'Blog',
	faq: 'FAQ',
}
const labels = { ...defaultLabels, ...breadcrumbLabels }

// Generate breadcrumb items from URL path
const pathParts = Astro.url.pathname.split('/').filter(Boolean)
const breadcrumbItems = [{ '@type': 'ListItem', position: 1, name: labels.beranda, item: SITE.url }]
let currentPath = ''
pathParts.forEach((part) => {
	currentPath += `/${part}`
	breadcrumbItems.push({
		'@type': 'ListItem',
		position: breadcrumbItems.length + 1,
		name: labels[part] || part.charAt(0).toUpperCase() + part.slice(1),
		item: `${SITE.url}${currentPath}`,
	})
})
const ogImageURL = new URL(image, Astro.url)
const isFallback = image === '/images/og-fallback.png' || image === '/logo-yayasan.webp'
const ogImageWidth = isFallback ? '1024' : '1200'
const ogImageHeight = isFallback ? '1024' : '630'
const ogImageType = image.endsWith('.png') ? 'image/png' : 'image/webp'
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#052e16" />
<meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<meta name="robots" content="index, follow" />
<meta name="author" content={SITE.name} />
<meta name="application-name" content={SITE.shortName} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="format-detection" content="telephone=no" />
<meta name="referrer" content="origin-when-cross-origin" />

<!-- Content Security Policy: ditetapkan terpusat lewat header di src/middleware.ts -->

<!-- Google Fonts: Inter + Plus Jakarta Sans (non-render-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Plus+Jakarta+Sans:wght@700..800&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.setAttribute('media', 'all')"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Plus+Jakarta+Sans:wght@700..800&display=swap"
    rel="stylesheet"
  />
</noscript>

<!-- Web Vitals monitoring script -->
<meta name="msapplication-TileColor" content="#052e16" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" href="/logo-yayasan-sm.webp" sizes="256x256" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
<link rel="dns-prefetch" href="https://cdn.sanity.io" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title} — {SITE.shortName}</title>
<meta name="title" content={`${title} — ${SITE.shortName}`} />
<meta name="description" content={description} />

<meta property="og:type" content={pageType} />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content={SITE.shortName} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={`${title} — ${SITE.shortName}`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={ogImageWidth} />
<meta property="og:image:height" content={ogImageHeight} />
<meta property="og:image:alt" content={SITE.shortName} />
<meta property="og:image:type" content={ogImageType} />

<meta name="twitter:card" content={isFallback ? "summary" : "summary_large_image"} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={`${title} — ${SITE.shortName}`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={SITE.shortName} />

<script is:inline type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${SITE.url}/#website`,
	"url": SITE.url,
	"name": SITE.shortName,
	"description": SITE.description,
	"potentialAction": {
		"@type": "SearchAction",
		"target": {
			"@type": "EntryPoint",
			"urlTemplate": `${SITE.url}/?q={search_term_string}`
		},
		"query-input": "required name=search_term_string"
	}
})}></script>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "NGO",
	"@id": `${SITE.url}/#organization`,
	"name": SITE.name,
	"alternateName": SITE.shortName,
	"description": SITE.description,
	"url": SITE.url,
	"logo": `${SITE.url}/logo-yayasan.webp`,
	"foundingDate": SITE.foundedDate,
	"legalName": SITE.name,
	"taxID": SITE.legal.npwp,
	"areaServed": "ID",
	"knowsAbout": ["Pendidikan Islam", "Keagamaan", "Sosial Kemanusiaan"],
	"address": {
		"@type": "PostalAddress",
		"streetAddress": CONTACT.address.street + ', ' + CONTACT.address.village + ', ' + CONTACT.address.district,
		"addressLocality": CONTACT.address.city,
		"addressRegion": CONTACT.address.province,
		"postalCode": CONTACT.address.postalCode,
		"addressCountry": "ID",
	},
	"contactPoint": [
		{
			"@type": "ContactPoint",
			"telephone": CONTACT.phone,
			"contactType": "customer service",
			"email": CONTACT.email,
		},
	],
	"sameAs": [
		SOCIAL.facebook.url,
		SOCIAL.instagram.url,
		SOCIAL.youtube.url,
		SOCIAL.tiktok.url,
	],
})}></script>

{breadcrumbItems.length > 1 && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"@id": `${canonicalURL}#breadcrumb`,
		"itemListElement": breadcrumbItems,
	})}></script>
)}

{pageType === 'article' && publishedTime && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		"@id": `${canonicalURL}#article`,
		"headline": title,
		"description": description,
		"image": ogImageURL,
		"datePublished": publishedTime,
		"dateModified": modifiedTime || publishedTime,
		"author": {
			"@type": "Organization",
			"@id": `${SITE.url}/#organization`,
		},
		"publisher": {
			"@type": "Organization",
			"@id": `${SITE.url}/#organization`,
		},
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": canonicalURL,
		},
	})}></script>
)}

<!-- Service Worker Registration -->
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker
        .register('/sw.js', { scope: '/' })
        .then((registration) => {
          console.log('✅ Service Worker registered successfully:', registration.scope);
          
          // Listen for updates
          registration.onupdatefound = () => {
            const installingWorker = registration.installing;
            if (installingWorker) {
              installingWorker.onstatechange = () => {
                if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  // New service worker found, show update notification
                  if (confirm('🔄 Update available. Reload to apply new features?')) {
                    window.location.reload();
                  }
                }
              };
            }
          };
        })
        .catch((error) => {
          console.error('❌ Service Worker registration failed:', error);
        });
    });
  }
</script>

<!-- Google Analytics 4 (GA4) - Basic Implementation -->
<!-- Only load in production to avoid contaminating analytics with dev traffic -->
{import.meta.env.PROD && (
  <>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-L3WQTPSJGN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-L3WQTPSJGN', {
        anonymize_ip: true,
        send_page_view: true
      });
    </script>
    
    <!-- OpenPanel Analytics - Complementary to GA4 -->
    <!-- Tracks screen views, outgoing links, and custom events -->
    <OpenPanelComponent
      clientId="fb2fde50-e95a-4707-b6c7-3938c8b12b5f"
      trackScreenViews={true}
      trackOutgoingLinks={true}
      trackAttributes={true}
      globalProperties={{
        environment: 'production',
        domain: 'amalshalih.or.id'
      }}
    />
  </>
)}

<!-- DebugBear RUM — Real User Monitoring (production only) -->
{import.meta.env.PROD && (
  <script is:inline>
    (function(){var dbpr=100;if(Math.random()*100>100-dbpr){var d="dbbRum",w=window,o=document,a=addEventListener,scr=o.createElement("script");scr.async=!0;w[d]=w[d]||[];w[d].push(["presampling",dbpr]);["error","unhandledrejection"].forEach(function(t){a(t,function(e){w[d].push([t,e])});});scr.src="https://cdn.debugbear.com/oSrCRQQlFdYm.js";o.head.appendChild(scr);}})()
  </script>
)}
