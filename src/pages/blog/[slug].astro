---
import { getCollection, render } from 'astro:content'
import Badge from '@components/ui/Badge.astro'
import Container from '@components/ui/Container.astro'
import Heading from '@components/ui/Heading.astro'
import Icon from '@components/ui/Icon.astro'
import Image from '@components/ui/Image.astro'
import Link from '@components/ui/Link.astro'
import type { IconName } from '@components/ui/types'
import { SITE } from '@data/site'
import BaseLayout from '@layouts/BaseLayout.astro'
import { getBlogPost, getBlogPostList } from '@lib/sanity/client'
import { renderPortableText } from '@lib/sanity/render'
import { withNull } from '@lib/with-fallback'

// SSR mode for Cloudflare Workers
export const prerender = false

const { slug } = Astro.params
if (!slug) {
	return Astro.redirect('/blog')
}

// Try Sanity first
const sanityPost = await withNull(() => getBlogPost(slug), 'Blog post detail fetch')
let postFromSanity = !!sanityPost

let post: {
	id: string
	data: {
		title: string
		description: string
		date: Date
		image?: string
		category?: string
		author?: string
	}
	body?: unknown
} | null = null

// eslint-disable-next-line @typescript-eslint/no-explicit-any
let Content: any = null

if (sanityPost) {
	post = {
		id: sanityPost.slug,
		data: {
			title: sanityPost.title,
			description: sanityPost.excerpt ?? '',
			date: new Date(sanityPost.date),
			image: sanityPost.imageUrl,
			category: sanityPost.category,
			author: sanityPost.author,
		},
		body: sanityPost.body,
	}
}

// Fall back to markdown collection
if (!post) {
	const blogPosts = await getCollection('blog')
	const markdownPost = blogPosts.find((p) => p.id === slug)
	if (markdownPost) {
		post = {
			id: markdownPost.id,
			data: {
				title: markdownPost.data.title,
				description: markdownPost.data.description,
				date: markdownPost.data.date,
				image: markdownPost.data.image,
				category: markdownPost.data.category,
				author: markdownPost.data.author,
			},
		}
		const { Content: MarkdownContent } = await render(markdownPost)
		Content = MarkdownContent
	}
}

if (!post) {
	return Astro.redirect('/blog')
}

const formattedDate = post.data.date.toLocaleDateString('id-ID', {
	weekday: 'long',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
})

// Estimate reading time (avg 200 words per minute)
const words = post.body ? String(post.body).split(/\s+/).length : 0
const readingTime = Math.ceil(words / 200) || 3

// Fetch related posts from markdown + Sanity fallback
const allPosts = await getCollection('blog')
let relatedPosts: {
	id: string
	data: {
		title: string
		description: string
		date: Date
		image?: string
		category?: string
		author?: string
	}
}[] = allPosts
	.filter((p) => p.id !== post.id && p.data.category === post.data.category)
	.slice(0, 3)
	.map((p) => ({
		id: p.id,
		data: { ...p.data, image: p.data.image },
	}))

// Supplement with Sanity posts if markdown has few related matches
if (relatedPosts.length < 3 && postFromSanity) {
	const sanityPosts = await getBlogPostList()
	if (sanityPosts.length > 0) {
		const excludeIds = new Set([post.id, ...allPosts.map((p) => p.id)])
		const sanitySupplement = sanityPosts
			.filter((p) => !excludeIds.has(p.slug) && p.category === post.data.category)
			.slice(0, 3 - relatedPosts.length)
			.map((p) => ({
				id: p.slug,
				data: {
					title: p.title,
					description: p.excerpt ?? '',
					date: new Date(p.date),
					image: p.imageUrl,
					category: p.category,
					author: p.author,
				},
			}))
		relatedPosts = [...relatedPosts, ...sanitySupplement]
	}
}

// Category-based cross-links to related pages
const categoryExploreLinks: Record<string, { label: string; href: string; icon: IconName }[]> = {
	Pendidikan: [
		{ label: 'Program Pendidikan', href: '/program#pendidikan', icon: 'book' },
		{ label: 'Kegiatan Terbaru', href: '/kegiatan', icon: 'calendar' },
	],
	Keagamaan: [
		{ label: 'Program Keagamaan', href: '/program#keagamaan', icon: 'book' },
		{ label: 'Kegiatan Keagamaan', href: '/kegiatan', icon: 'calendar' },
	],
	Sosial: [
		{ label: 'Program Sosial', href: '/program#sosial', icon: 'book' },
		{ label: 'Kegiatan Sosial', href: '/kegiatan', icon: 'calendar' },
	],
	Donasi: [{ label: 'Salurkan Donasi', href: '/donasi', icon: 'heart' }],
}
const exploreLinks = (post.data.category && categoryExploreLinks[post.data.category]) || []

// Article structured data for Google rich snippets
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString(),
	dateModified: post.data.date.toISOString(),
	author: post.data.author
		? {
				'@type': 'Person',
				name: post.data.author,
			}
		: {
				'@type': 'Organization',
				name: SITE.name,
			},
	publisher: {
		'@type': 'Organization',
		name: SITE.name,
		url: SITE.url,
		logo: {
			'@type': 'ImageObject',
			url: `${SITE.url}/logo-yayasan.webp`,
		},
	},
	image: post.data.image ? { '@type': 'ImageObject', url: post.data.image } : undefined,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `${SITE.url}/blog/${post.id}`,
	},
}
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	image={post.data.image}
	pageType="article"
	publishedTime={post.data.date.toISOString()}
	modifiedTime={post.data.date.toISOString()}
	currentPage={`/blog/${post.id}`}
>
	<!-- Article Structured Data for Google Rich Snippets -->
	<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

	<!-- Full-Width Hero Section with Overlap -->
	<div class="relative w-full overflow-hidden -mt-[70px] sm:-mt-[82px]">
		<!-- Full-Bleed Ambient Background Glow -->
		{post.data.image && (
			<div class="absolute inset-0 z-0 overflow-hidden bg-transparent pointer-events-none" aria-hidden="true">
				<img
					src={post.data.image}
					alt=""
					class="w-full h-full object-cover blur-sm opacity-60 mix-blend-screen"
					style="-webkit-mask-image: linear-gradient(to bottom, black 10%, transparent 100%); mask-image: linear-gradient(to bottom, black 10%, transparent 100%);"
				/>
			</div>
		)}

		<Container as="div" class="relative z-10 pt-[82px] sm:pt-[96px] pb-16 sm:pb-20 md:pb-24">
			<div class="mx-auto max-w-3xl">
<!-- Breadcrumbs -->
				<nav class="py-4 mb-6 flex items-center gap-2 text-xs font-medium text-warm-700 dark:text-warm-200">
					<a href="/" class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors">Beranda</a>
					<Icon name="chevron-right" size={3} class="shrink-0 translate-y-[1px]" />
					<a href="/blog" class="hover:text-primary-700 dark:hover:text-primary-300 transition-colors">Blog</a>
					<Icon name="chevron-right" size={3} class="shrink-0 translate-y-[1px]" />
					<span class="text-warm-900 dark:text-warm-100 truncate">{post.data.title}</span>
				</nav>

				<!-- Asymmetric Header Layout -->
				<div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
					<!-- Left: Title & Metadata -->
					<div class="md:col-span-7 text-left">
						<div class="hidden md:flex items-center gap-1.5 text-[10px] sm:text-xs font-bold uppercase tracking-widest text-warm-900 dark:text-warm-100 mb-3">
							<Icon name="calendar" size={3} class="shrink-0" />
							<span class="bg-white/80 dark:bg-warm-900/80 backdrop-blur-sm px-2 py-0.5 rounded">
								{formattedDate}
							</span>
						</div>
						<h1 class="mb-4 text-3xl font-extrabold tracking-tight text-warm-900 dark:text-warm-100 sm:text-4xl lg:text-5xl leading-tight">
							{post.data.title}
						</h1>
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs sm:text-sm text-warm-800 dark:text-warm-300 font-medium">
							<span class="text-warm-900 dark:text-warm-100 font-bold">{post.data.author}</span>
							<span class="hidden sm:inline text-warm-500 dark:text-warm-500">•</span>
							<Badge variant="primary" size="sm" class="px-2 py-0.5">
								{post.data.category || 'Edukasi'}
							</Badge>
							<span class="hidden sm:inline md:hidden text-warm-500 dark:text-warm-500">•</span>
							<div class="flex items-center gap-1.5 md:hidden">
								<Icon name="calendar" size={3.5} class="shrink-0" />
								{formattedDate}
							</div>
							<span class="hidden sm:inline text-warm-500 dark:text-warm-500">•</span>
							<div class="flex items-center gap-1.5">
								<Icon name="clock" size={3.5} class="shrink-0" />
								{readingTime} mnt baca
							</div>
						</div>
					</div>

					<!-- Right: Featured Image (Larger & Offloaded) -->
					<div class="md:col-span-5 flex justify-center md:justify-end">
						{post.data.image && (
							<div class="relative group md:-mr-16 md:translate-x-8">
								<!-- Decorative shadow/glow -->
								<div class="absolute -inset-2 bg-gradient-to-r from-primary-600 to-gold-500 rounded-3xl blur opacity-20 group-hover:opacity-40 transition-opacity"></div>

								<!-- Image Container (Clean, no border, smooth lift animation) -->
								<div class="relative overflow-hidden rounded-2xl shadow-2xl transition-all duration-700 hover:-translate-y-2 hover:shadow-3xl rotate-2">
									<img
										src={post.data.image}
										alt={post.data.title}
										class="w-full max-w-sm h-auto object-cover aspect-[4/3]"
										loading="eager"
										decoding="async"
									/>
								</div>
							</div>
						)}
					</div>
				</div>
			</div>
		</Container>
	</div>

	<!-- Article Content Card (No Overlap) -->
	<section class="mx-auto max-w-6xl sm:px-6 lg:px-8 relative z-20">
		<div class="mx-auto max-w-3xl bg-gradient-to-b from-white/20 via-white/80 to-white/90 dark:from-warm-900/20 dark:via-warm-900/80 dark:to-warm-900/90 rounded-t-3xl shadow-2xl backdrop-blur-sm px-4 py-5 sm:p-6 lg:p-8">
			<!-- Article Body with Prose Typography -->
			<div class="prose prose-slate max-w-none
				prose-headings:text-warm-900 dark:prose-headings:text-warm-100 prose-headings:tracking-tight
				prose-p:text-warm-700 dark:prose-p:text-warm-300 prose-p:leading-relaxed
				prose-a:text-primary-600 dark:prose-a:text-primary-400 hover:prose-a:text-primary-700 dark:hover:prose-a:text-primary-300 prose-a:font-medium
				prose-strong:text-warm-900 dark:prose-strong:text-warm-100 prose-strong:font-bold
				prose-blockquote:border-l-primary-500 dark:prose-blockquote:border-l-primary-400 prose-blockquote:bg-primary-50 dark:prose-blockquote:bg-primary-900/30 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg
				prose-img:rounded-2xl prose-img:shadow-md
				sm:prose-lg">
				{postFromSanity && post.body ? (
					<div set:html={renderPortableText(post.body)} />
				) : (
					<Content />
				)}
			</div>

			<!-- Footer / Engagement Section -->
			<div class="mt-20 space-y-12">
				<!-- Share & CTA -->
				<div class="rounded-3xl bg-gradient-to-br from-primary-800 to-primary-950 p-8 sm:p-12 text-center text-white shadow-xl">
					<Heading level="h3" size="2xl" class="text-white mb-4">Suka dengan artikel ini?</Heading>
					<p class="mb-8 text-primary-100 opacity-90 max-w-xl mx-auto">
						Bagikan informasi bermanfaat ini kepada keluarga dan kerabat untuk menebar kemaslahatan bersama.
					</p>
					<div class="flex flex-col sm:flex-row justify-center gap-4">
						<Link href="https://wa.me/share?text=Baca artikel menarik ini: " external class="inline-flex items-center justify-center gap-2 rounded-xl bg-green-600 px-6 py-3 text-sm font-bold text-white hover:bg-green-705 transition-all hover:scale-105 shadow-lg active:scale-95">
							<Icon name="whatsapp" size={4} />
							Bagikan via WhatsApp
						</Link>
						<Link href="/blog" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white/10 backdrop-blur-sm px-6 py-3 text-sm font-bold text-white border border-white/20 hover:bg-white/20 transition-all hover:scale-105 active:scale-95">
							<Icon name="arrow-left" size={4} />
							Kembali ke Blog
						</Link>
					</div>
				</div>

				<!-- CTA Donasi -->
				<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary-700 to-primary-900 p-6 sm:p-8 lg:p-10 text-center shadow-xl">
					<div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-white/5" />
					<div class="absolute -bottom-16 -left-16 h-56 w-56 rounded-full bg-white/5" />
					<div class="relative z-10">
						<div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-white/15">
							<Icon name="heart" size={6} class="text-gold-300" aria-hidden="true" />
						</div>
						<Heading level="h2" size="lg" class="text-white">Dukung Program Kami</Heading>
						<p class="mx-auto mt-2 max-w-md text-sm sm:text-base leading-relaxed text-primary-100">
							Setiap donasi Anda membantu kami menjangkau lebih banyak penerima manfaat dan mewujudkan dampak nyata bagi umat.
						</p>
						<div class="mt-4 sm:mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center sm:gap-4">
							<a
								href="/donasi"
								class="flex w-full sm:w-auto items-center justify-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-primary-700 shadow-lg transition-all duration-200 hover:bg-primary-50 hover:scale-[1.02] active:scale-95"
							>
								Donasi Sekarang
								<Icon name="arrow-right" size={5} aria-hidden="true" />
							</a>
						</div>
					</div>
				</div>

				<!-- Related Posts -->
				{relatedPosts.length > 0 && (
					<div class="pt-12 border-t border-warm-200 dark:border-warm-700">
						<Heading level="h3" size="2xl" class="text-warm-900 dark:text-warm-100 mb-8 flex items-center gap-3">
							<span class="h-8 w-1 bg-primary-600 dark:bg-primary-400 rounded-full"></span>
							Artikel Terkait
						</Heading>
						<!-- Mobile: horizontal snap carousel dengan negatif margin agar full-bleed / Desktop: grid -->
						<div class="-mx-4 px-4 flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-pl-4 pb-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:snap-none sm:pb-0 lg:grid-cols-3">
							{relatedPosts.map(post => (
								<a href={`/blog/${post.id}`} class="group block overflow-hidden rounded-2xl border border-warm-100 dark:border-warm-700 bg-white dark:bg-warm-900 hover:border-primary-200 dark:hover:border-primary-600 hover:shadow-md transition-all w-[75vw] min-w-[260px] sm:w-auto sm:min-w-0 snap-start shrink-0 sm:shrink">
									<div class="aspect-video overflow-hidden">
										<Image
											src={post.data.image || '/logo-yayasan.webp'}
											alt={post.data.title}
											aspect="aspect-video"
											width={480}
											height={270}
											class="group-hover:scale-105 transition-transform duration-500"
										/>
									</div>
									<div class="p-4">
										<Heading level="h4" size="sm" class="text-warm-900 dark:text-warm-100 group-hover:text-primary-700 dark:group-hover:text-primary-400 transition-colors line-clamp-2 mb-2">
											{post.data.title}
										</Heading>
										<p class="text-xs text-warm-500 dark:text-warm-400 line-clamp-2 leading-relaxed">
											{post.data.description}
										</p>
									</div>
								</a>
							))}
						</div>
					</div>
				)}

				<!-- Cross-Links: Halaman Terkait (by category) -->
				{exploreLinks.length > 0 && (
					<div class="pt-8 border-t border-warm-200 dark:border-warm-700">
						<Heading level="h3" size="lg" class="text-warm-900 dark:text-warm-100 mb-6 flex items-center gap-3">
							<span class="h-8 w-1 bg-gold-500 rounded-full"></span>
							Jelajahi Lebih Lanjut
						</Heading>
						<div class="grid gap-4 sm:grid-cols-2">
							{exploreLinks.map((link) => (
								<a
									href={link.href}
									class="group flex items-center gap-4 rounded-2xl border border-warm-100 dark:border-warm-700 bg-white dark:bg-warm-900 p-5 hover:border-primary-200 dark:hover:border-primary-600 hover:shadow-md transition-all"
								>
									<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary-50 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300 group-hover:bg-primary-100 dark:group-hover:bg-primary-800/50 transition-colors">
										<Icon name={link.icon} size={6} />
									</div>
									<div>
										<span class="block text-sm font-semibold text-warm-900 dark:text-warm-100 group-hover:text-primary-700 dark:group-hover:text-primary-400 transition-colors">
											{link.label}
										</span>
										<span class="text-xs text-warm-500 dark:text-warm-400 mt-0.5">{link.href}</span>
									</div>
								</a>
							))}
						</div>
					</div>
				)}
		</div>
	</section>
</BaseLayout>
