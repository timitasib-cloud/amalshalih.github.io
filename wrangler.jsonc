{
	"name": "www",
	"main": "./src/server/sentry-worker.mjs",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"NODE_ENV": "production",
		// Server-side Sentry (@sentry/cloudflare withSentry reads these at runtime)
		// DSN is a public identifier — same value is already shipped to browsers.
		"SENTRY_DSN": "https://e99692c45d83afc7713330e193ea5a9a@o4511465723396096.ingest.us.sentry.io/4511465782509568",
		"SENTRY_ENVIRONMENT": "production"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "1fcf5a834af8489790a5e55793205d2a"
		},
		{
			"binding": "LIKES",
			"id": "0525d17bcb8b43098ec8415b976e2dca"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	// Agent Memory binding - explicitly declared to suppress Wrangler warning
	// This project does not use Agent Memory, so the array is intentionally empty
	// Field is auto-generated by @astrojs/cloudflare adapter during build
	"agent_memory": [],
	// Custom Domains - managed via Wrangler (not Dashboard)
	// These will create DNS records and SSL certificates automatically
	"routes": [
		{
			"pattern": "amalshalih.or.id",
			"custom_domain": true
		},
		{
			"pattern": "www.amalshalih.or.id",
			"custom_domain": true
		}
	]
}
